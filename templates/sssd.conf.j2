# Managed by Ansible (ad-join.yml) - local edits will be overwritten
[sssd]
domains = {{ ad_domain }}
config_file_version = 2
services = nss, pam

[pam]
# Warn users N days before their AD password expires
pam_pwd_expiration_warning = 7

[domain/{{ ad_domain }}]
ad_domain = {{ ad_domain }}
krb5_realm = {{ ad_realm }}
realmd_tags = manages-system joined-with-adcli

id_provider = ad
auth_provider = ad
chpass_provider = ad
access_provider = simple
simple_allow_groups = {{ ad_login_groups | join(', ') }}

cache_credentials = True
krb5_store_password_if_offline = True
use_fully_qualified_names = {{ use_fully_qualified_names | ternary('True', 'False') }}
fallback_homedir = {{ home_dir_pattern }}
default_shell = /bin/bash

# Use POSIX IDs generated from AD SIDs (consistent across all servers)
ldap_id_mapping = True
